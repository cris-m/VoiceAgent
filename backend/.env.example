# Backend service config. Copy to backend/.env. Values left empty here are
# either optional or required for specific features (HF_TOKEN for cloning,
# API_KEY for static auth). Real keys never go in this file.

# Application
APP_NAME=VoiceAgent
APP_VERSION=0.1.0
DEBUG=false
ENVIRONMENT=development

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=1
RELOAD=true

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Database (overridden by docker-compose; only set here for non-Docker runs)
DATABASE_AUTH_URL=postgresql+asyncpg://langgraph:langgraph@localhost:5432/langgraph
DATABASE_URL=postgresql+psycopg2://langgraph:langgraph@localhost:5432/langgraph
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=0

# Redis
REDIS_URL=redis://localhost:6379/0

# Authentication
# Generate SECRET_KEY with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=development-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=30
JWT_REFRESH_EXPIRATION_DAYS=7
PASSWORD_HASH_ALGORITHM=bcrypt
PASSWORD_MIN_LENGTH=8

# Static API key. If set, every API call needs Authorization: Bearer <key>.
API_KEY=
MAX_WS_CONNECTIONS=10

# Speech-to-text. whisper is the only wired provider.
STT_PROVIDER=whisper
WHISPER_MODEL=distil-large-v3
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=8

# Text-to-speech. kokoro (8 voices, speed/language) or pocket_tts (27 voices, cloning).
TTS_PROVIDER=kokoro
KOKORO_VOICE=af_heart
KOKORO_LANGUAGE=en-us
KOKORO_SPEED=1.0
KOKORO_MODEL_PATH=
KOKORO_VOICES_PATH=
POCKET_TTS_LANGUAGE=english
POCKET_TTS_VOICE=alba

# WebSocket
WS_HEARTBEAT_INTERVAL=
WS_MAX_MESSAGE_SIZE=

# Audio
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_STREAM_CHUNK_MS=100

# VAD
VAD_ENABLED=true
VAD_THRESHOLD=0.5
VAD_MIN_SILENCE_DURATION_MS=300
VAD_MIN_SPEECH_DURATION_MS=200

# LangGraph agent service URL. Inside Docker: http://agent:8000.
LANGGRAPH_URL=http://agent:8000

# Rate limiting
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# Text chunking for narration
TEXT_CHUNK_THRESHOLD=2000
TEXT_MAX_CHUNK_SIZE=1500

# Audio file processing
AUDIO_CHUNK_THRESHOLD=60
AUDIO_FILE_CHUNK_DURATION_MS=30000
AUDIO_SILENCE_THRESH_DB=-40
AUDIO_MIN_SILENCE_MS=500

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# Music generation
MUSIC_PROVIDER=ace_step

# HuggingFace token. Required only for Pocket TTS voice cloning. Generate at
# https://huggingface.co/settings/tokens, then accept the gated model terms
# at https://huggingface.co/kyutai/pocket-tts.
HF_TOKEN=
