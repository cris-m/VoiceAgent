# Project-root .env. Loaded by docker-compose for variable substitution
# in compose files (POSTGRES_*, COMPOSE_*).
#
# Service config lives in backend/.env and agent/.env. Copy this to .env
# and adjust the postgres credentials before deploying anywhere real.

COMPOSE_PROJECT_NAME=voice_agent
COMPOSE_PROFILES=postgres,redis,client,nginx,server,agent

POSTGRES_DB=langgraph
POSTGRES_USER=langgraph
POSTGRES_PASSWORD=change-me-in-production
