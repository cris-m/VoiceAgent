# Development Dockerfile - Vite dev server with HMR
FROM node:22-alpine

WORKDIR /app

# Copy package files
COPY package.json package-lock.json* ./

# Install dependencies
RUN npm install --legacy-peer-deps

# Copy source (rest handled by volume mount in dev)
COPY . .

# Run Vite dev server with proper host binding
ENV HOST=0.0.0.0
ENV VITE_API_URL=http://localhost:8080

# Expose both dev server and HMR port
EXPOSE 3000 5173

CMD ["npm", "run", "dev"]
