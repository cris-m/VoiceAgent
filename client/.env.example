# Frontend build-time config. Copy to client/.env. No secrets here:
# everything prefixed VITE_ is inlined into the public bundle at build time.
#
# VITE_API_URL changes depending on how you run the client:
#   Docker (recommended): http://localhost:8080/api/v1
#   Without nginx/Docker:  http://localhost:8000

VITE_LANGGRAPH_API_URL=/api
VITE_API_URL=http://localhost:8080/api/v1
VITE_AGENT_API_BASE=/api/v1/agent
VITE_CHAT_API_ENDPOINT=/api/runs/stream
