# Agent service config. Copy to agent/.env. Real keys never go in this file.

# LangChain init_chat_model spec. Examples:
#   openai:gpt-4o-mini
#   anthropic:claude-3-5-haiku-20241022
#   ollama:llama3
#   nvidia:moonshotai/kimi-k2.5
AGENT_MODEL=openai:gpt-4o-mini
AGENT_TEMPERATURE=0.7
MAX_RESULTS=5

# LLM and tool API keys (set the ones you use)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
NVIDIA_API_KEY=
GOOGLE_API_KEY=
TAVILY_API_KEY=
HF_TOKEN=

# Observability (optional)
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGCHAIN_PROJECT=voiceagent
